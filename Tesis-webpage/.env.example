# AquaControl - Variables de Entorno para Next.js y Supabase
# Copia este archivo como .env.local para desarrollo local

# 1. Credenciales de Supabase
# Obtenidas en: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# Clave Service Role (SOLO para el servidor API de Next.js, NUNCA exponer al cliente)
# Necesaria para verificar X-Device-Key y gestionar comandos de dispositivos
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-aqui

# 2. Configuración de Dispositivos ESP32 (Para Pruebas y Scripts)
# Tokens en texto plano que llevarán los ESP32 en el header X-Device-Key
# (El servidor calculará el SHA-256 para validarlo con la base de datos)
ESP32_SENSOR_DEVICE_KEY=ESP32_SENSOR_KEY_2026
ESP32_MOTOR_DEVICE_KEY=ESP32_MOTOR_KEY_2026

# 3. Flags de Aplicación
# Activa el modo de datos simulados en caso de no tener conexión a Supabase aún
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
