# =============================================================================
# aqua-gateway configuration template
# =============================================================================
# Deploy to: /etc/aqua/gateway.env   (mode 0640, owner aqua:aqua)
#
# All settings are prefixed AQUA_ and use __ as the nesting delimiter, so
# AQUA_MQTT__HOST maps to settings.mqtt.host. Validation happens at boot: a
# malformed value fails immediately rather than at 03:00 when the flush runs.
# =============================================================================

# -- environment --------------------------------------------------------------
AQUA_ENVIRONMENT=production
AQUA_LOG_LEVEL=INFO
AQUA_LOG_JSON=true

# Rotation, retention and the daily flush all key off this, NOT the host clock.
# The board shipped on Europe/London while the project is America/Lima — a
# mismatch would misfile every nightly archive file by five hours.
AQUA_TIMEZONE=America/Lima

# -- API ----------------------------------------------------------------------
# Loopback only. Caddy is the single LAN-facing surface, and it proxies /api and
# /events on the same origin so the dashboard's relative URLs work unchanged.
AQUA_API_HOST=127.0.0.1
AQUA_API_PORT=8000

# -- MQTT ---------------------------------------------------------------------
# Plain TCP on the LAN by deliberate choice: every node shares one AP with the
# broker, so TLS would cost each ESP32 ~40-60 KB RAM and 1-3 s per handshake to
# protect an already-private link.
AQUA_MQTT__HOST=127.0.0.1
AQUA_MQTT__PORT=1883
AQUA_MQTT__USERNAME=gateway
AQUA_MQTT__PASSWORD=CHANGE_ME
AQUA_MQTT__CLIENT_ID=aqua-gateway
AQUA_MQTT__KEEPALIVE=60

# -- archive ------------------------------------------------------------------
AQUA_ARCHIVE__ROOT=/data/telemetry
AQUA_ARCHIVE__BLOCK_BYTES=65536

# A buffer is released on size OR age, whichever comes first. Size alone ties the exposure
# to the sampling rate rather than to time: 64 KB is minutes at 5 Hz, but over an hour for
# the od_sensor's real 0.2 Hz. The age cap is what makes "how much do I lose on a power
# cut?" a duration instead of a byte count. A role that stops sending is still released,
# by the gateway's maintenance sweep.
#
# Every release is fsynced, so this is the whole exposure -- there is no page-cache interval
# on top of it. That matters for choosing the number: a release is one write AND one commit,
# so the cap sets the floor on both. 300 s costs an idle-cadence role ~288 releases/day;
# 60 s cost it ~1440, five times the write count, for an exposure that the fsync already
# bounds usefully.
AQUA_ARCHIVE__MAX_BUFFER_AGE_S=300

# No fsync during normal appends — telemetry tolerates losing the unflushed tail of a
# live file on power loss. At 5 Hz the byte trigger alone is 3.6-6.0 minutes (64 KB block;
# 36-61 bytes per row depending on role), NOT the "few seconds" this comment used to
# claim. A graceful stop flushes everything; only a power cut loses it.
AQUA_ARCHIVE__FSYNC_ON_ROTATE=true

AQUA_ARCHIVE__UNKNOWN_FIELDS_PATH=/data/telemetry/unknown

# -- manifest -----------------------------------------------------------------
AQUA_MANIFEST_PATH=/var/lib/aqua-gateway/manifest.db

# -- retention ----------------------------------------------------------------
# Deletion requires the archive to be VERIFIED to hold a file: flush-aware, not
# calendar-driven. If the Pi is off for a month, nothing is deleted.
AQUA_RETENTION_DAYS=14
AQUA_MAX_LOCAL_BYTES=8589934592
AQUA_MIN_FREE_BYTES=2147483648
AQUA_PRUNE_MODE=both

# -- live view ----------------------------------------------------------------
AQUA_LIVE_SSE_HZ=1.0
AQUA_LIVE_HISTORY_POINTS=600

# -- rollups ------------------------------------------------------------------
AQUA_ROLLUP_INTERVAL_S=60

# -- database -----------------------------------------------------------------
# TCP to loopback, with a password. Both parts are load-bearing.
#
# `sslmode=disable` is a requirement, not an optimisation. asyncpg negotiates TLS by
# default, and its TLS path reads a client certificate from ~/.postgresql/.
# aqua-gateway.service sets ProtectHome=true, so that path is not merely absent but
# unreadable, and the resulting EACCES aborts the connection. It is also the only
# symptom the operator gets:
#
#   database unavailable, continuing without it
#   error: [Errno 13] Permission denied: '/home/aqua/.postgresql/postgresql.key'
#
# which says nothing about TLS, and hides whatever the real problem is -- in the case
# that found this, missing database credentials. There is nothing to protect on
# loopback, so the answer is not to negotiate TLS at all.
#
# The password is generated and written by deploy/install.sh. Debian's pg_hba requires
# scram-sha-256 for host connections and `createuser` sets no password, so a fresh
# install without one cannot authenticate.
AQUA_DATABASE_URL=postgresql://aqua@127.0.0.1:5432/aqua?sslmode=disable
AQUA_DB_POOL_MIN=1
AQUA_DB_POOL_MAX=8

# -- backup to Supabase Storage (S3-compatible) -------------------------------
# Free tier: 1 GB storage / 5 GB egress. Raw archive is ~100 MB/year gzipped.
AQUA_BACKUP__ENABLED=true
AQUA_BACKUP__BUCKET=aqua-archive
AQUA_BACKUP__ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
AQUA_BACKUP__REGION=us-east-1
AQUA_BACKUP__ACCESS_KEY_ID=CHANGE_ME
AQUA_BACKUP__SECRET_ACCESS_KEY=CHANGE_ME

# Verify sha256 + row count against the remote object before marking flushed.
# Skipping this is how a truncated upload becomes the only copy.
AQUA_BACKUP__VERIFY_AFTER_UPLOAD=true

# -- thresholds (also drive derived process events) ---------------------------
# Critical must be below warning; the config validator enforces it.
AQUA_DO_WARNING_MG_L=5.0
AQUA_DO_CRITICAL_MG_L=3.0
AQUA_TEMP_WARNING_C=30.0
AQUA_CLOCK_OFFSET_WARN_MS=500
AQUA_TELEMETRY_GAP_WARN=3
