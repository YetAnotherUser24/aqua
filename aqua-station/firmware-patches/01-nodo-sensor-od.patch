 struct OdTelemetryPacket {
   uint32_t magic;           // AQUACONTROL_PACKET_MAGIC
   uint32_t sequence;        // Incremental sequence counter
-  uint64_t rtc_timestamp_ms; // Milliseconds since 2000 (RTC + millis() offset)
