index 0000000..a4ae583
--- /dev/null
+++ b/src/motor_bus_real.cpp
@@ -0,0 +1,71 @@
+/**
+ * @file motor_bus_real.cpp
+ * @brief Real `IMotorBus`: thin adapter over the existing ODriveUART driver.
+ *
+ * Build: the default (any non-virtual env). Contains no control logic — only the wiring
+ * between the node's interface and the ODrive S1 ASCII driver.
+ */
+
+#include "motor_bus.h"
+#include "odrive_uart.h"
+#include "config.h"
+
+#include <Arduino.h>
+
+namespace {
+
+class RealMotorBus : public IMotorBus {
+public:
+  RealMotorBus() : _serial(makeSerial()), _uart(_serial, ODRIVE_SERIAL_RX_PIN, ODRIVE_SERIAL_TX_PIN, ODRIVE_BAUD_RATE) {}
+
+  void tick(uint32_t /*nowMs*/) override {
+    // The real driver is ticked through updateTieredTelemetry(); nothing to do here.
+  }
+
+  bool begin() override { return _uart.begin(); }
+  bool setVelocityRpm(float rpm) override { return _uart.setVelocityRpm(rpm); }
+  bool setPosition(float turns) override { return _uart.setPosition(turns); }
+  bool setTorque(float torqueNm) override { return _uart.setTorque(torqueNm); }
+  bool setControlMode(uint8_t c, uint8_t i) override { return _uart.setControlMode(c, i); }
+  bool requestState(uint8_t s) override { return _uart.requestState(s); }
+  bool enterClosedLoop() override { return _uart.enterClosedLoop(); }
+  bool enterIdle() override { return _uart.enterIdle(); }
+  bool clearErrors() override { return _uart.clearErrors(); }
+
+  bool pollTelemetry(MotorTelemetry& outTelem) override {
+    return _uart.pollTelemetry(reinterpret_cast<ODriveTelemetry&>(outTelem));
+  }
+
+  void updateTieredTelemetry(MotorTelemetry& ioTelem, uint32_t tickIndex) override {
+    _uart.updateTieredTelemetry(reinterpret_cast<ODriveTelemetry&>(ioTelem), tickIndex);
+  }
+
+  bool readFeedbackFast(float& outTurns, float& outRpm) override {
+    return _uart.readFeedbackFast(outTurns, outRpm);
+  }
+
+  bool readFloatProperty(const char* p, float& v, uint32_t t = 60) override { return _uart.readFloatProperty(p, v, t); }
+  bool writeFloatProperty(const char* p, float v) override { return _uart.writeFloatProperty(p, v); }
+  bool sendRawCommand(const char* c, char* b, size_t n, uint32_t t = 100) override {
+    return _uart.sendRawCommand(c, b, n, t);
+  }
+
+private:
+  static HardwareSerial& makeSerial() {
+#if CONFIG_IDF_TARGET_ESP32S3
+    static HardwareSerial serial(1);
+#else
+    static HardwareSerial serial(2);
+#endif
+    return serial;
+  }
+
+  HardwareSerial& _serial;
+  ODriveUART _uart;
+};
+
+RealMotorBus g_bus;
+
+}  // namespace
+
+IMotorBus& motorBus() { return g_bus; }
diff --git a/src/motor_bus_virtual.cpp b/src/motor_bus_virtual.cpp
new file mode 100644
index 0000000..b6c50db
--- /dev/null
+++ b/src/motor_bus_virtual.cpp
@@ -0,0 +1,159 @@
+/**
+ * @file motor_bus_virtual.cpp
+ * @brief Virtual `IMotorBus`: binds the declarative MotorSim to the node interface.
+ *
+ * Build: selected by `-DAERADOR_VIRTUAL=1` (env `esp32-s3-virtual`). Never compiled into
+ * real firmware. Talk to the real backend; no ESP-NOW.
+ */
+
+#include "motor_bus.h"
+#include "motor_sim.h"
+#include "config.h"
+
+#include <Arduino.h>
+#include <string.h>
+#include <stdlib.h>
+
+namespace {
+
+class VirtualMotorBus : public IMotorBus {
+public:
+  VirtualMotorBus() {
+    MotorSimSpec spec;
+    spec.rpmMax = MAX_MOTOR_RPM;
+    spec.nominalVbus = VIRTUAL_VBUS_NOMINAL;
+    spec.idleIbus = VIRTUAL_IBUS_IDLE;
+    spec.maxLoadIbus = VIRTUAL_IBUS_MAX_LOAD;
+    _sim.setSpec(spec);
+    // Deterministic, demonstrable fault schedule (disabled unless VIRTUAL_FAULTS=1).
+#if defined(AERADOR_VIRTUAL_FAULTS) && AERADOR_VIRTUAL_FAULTS
+    _sim.addFaultEvent({15000, 0x00000001u});  // INITIALIZING-ish fault at 15 s
+    _sim.addFaultEvent({25000, 0x00000002u});  // another at 25 s
+#endif
+  }
+
+  void tick(uint32_t nowMs) override { _sim.tick(nowMs); }
+
+  bool begin() override {
+    _sim.reset();
+    _specApplied = true;
+    Serial.println("[MotorBus/Virtual] ODrive S1 simulation active.");
+    return true;
+  }
+
+  bool setVelocityRpm(float rpm) override {
+    _sim.requestVelocityRpm(rpm);
+    return true;
+  }
+  bool setPosition(float turns) override {
+    _sim.requestPositionTurns(turns);
+    return true;
+  }
+  bool setTorque(float torqueNm) override {
+    _sim.requestTorque(torqueNm);
+    return true;
+  }
+  bool setControlMode(uint8_t controlMode, uint8_t inputMode) override {
+    _controlMode = controlMode;
+    _inputMode = inputMode;
+    return true;
+  }
+  bool requestState(uint8_t state) override {
+    _sim.requestState(state);
+    return true;
+  }
+  bool enterClosedLoop() override {
+    _sim.clearErrors();
+    _sim.requestState(MOTOR_STATE_CLOSED_LOOP);
+    return true;
+  }
+  bool enterIdle() override {
+    _sim.requestState(MOTOR_STATE_IDLE);
+    return true;
+  }
+  bool clearErrors() override {
+    _sim.clearErrors();
+    return true;
+  }
+
+  bool pollTelemetry(MotorTelemetry& outTelem) override {
+    _sim.tick(millis());
+    fill(outTelem);
+    return true;
+  }
+
+  void updateTieredTelemetry(MotorTelemetry& ioTelem, uint32_t /*tickIndex*/) override {
+    // The simulator has no serial budget: one refresh per tick is strictly better than the
+    // real tiered schedule and never starves a field.
+    _sim.tick(millis());
+    fill(ioTelem);
+  }
+
+  bool readFeedbackFast(float& outTurns, float& outRpm) override {
+    _sim.tick(millis());
+    outTurns = _sim.actualRpm() / 60.0f * 0.0f;  // position not tracked externally here
+    outRpm = _sim.actualRpm();
+    return true;
+  }
+
+  bool readFloatProperty(const char* prop, float& outVal, uint32_t = 60) override {
+    if (!prop) return false;
+    if (strstr(prop, "vbus_voltage")) { outVal = _sim.vbus(); return true; }
+    if (strstr(prop, "ibus")) { outVal = _sim.ibus(); return true; }
+    if (strstr(prop, "vel_estimate")) { outVal = _sim.actualRpm() / 60.0f; return true; }
+    if (strstr(prop, "torque_estimate")) { outVal = _sim.torque(); return true; }
+    if (strstr(prop, "fet_thermistor")) { outVal = _sim.fetTemp(); return true; }
+    if (strstr(prop, "Iq_measured")) { outVal = _sim.iq(); return true; }
+    return false;
+  }
+
+  bool writeFloatProperty(const char* prop, float val) override {
+    if (!prop) return false;
+    if (strstr(prop, "vel_ramp_rate")) { _velRampRate = val; return true; }
+    if (strstr(prop, "input_vel")) { _sim.requestVelocityRpm(val * 60.0f); return true; }
+    return true;
+  }
+
+  bool sendRawCommand(const char* cmd, char* outBuf, size_t maxLen, uint32_t = 100) override {
+    if (!cmd) return false;
+    if (strcmp(cmd, "sc") == 0) return clearErrors();
+    if (outBuf && maxLen > 0) {
+      if (strstr(cmd, "vbus_voltage")) { snprintf(outBuf, maxLen, "%.2f", _sim.vbus()); return true; }
+      if (strstr(cmd, "active_errors")) { snprintf(outBuf, maxLen, "%u", (unsigned)_sim.axisError()); return true; }
+      if (strstr(cmd, "current_state")) { snprintf(outBuf, maxLen, "%u", (unsigned)_sim.state()); return true; }
+      if (strstr(cmd, "control_mode")) { snprintf(outBuf, maxLen, "%u", (unsigned)_controlMode); return true; }
+      if (strstr(cmd, "input_mode")) { snprintf(outBuf, maxLen, "%u", (unsigned)_inputMode); return true; }
+      outBuf[0] = '\0';
+    }
+    return true;
+  }
+
+private:
+  void fill(MotorTelemetry& t) {
+    t.vbus_voltage = _sim.vbus();
+    t.ibus_current = _sim.ibus();
+    t.actual_rpm = _sim.actualRpm();
+    t.power_watts = _sim.power();
+    t.torque_estimate = _sim.torque();
+    t.iq_measured = _sim.iq();
+    t.fet_temperature = _sim.fetTemp();
+    t.axis_error = _sim.axisError();
+    t.disarm_reason = (!_sim.isArmed() && _sim.state() == MOTOR_STATE_IDLE) ? 1u : 0u;
+    t.current_state = _sim.state();
+    t.control_mode = _controlMode;
+    t.input_mode = _inputMode;
+    t.is_armed = _sim.isArmed();
+  }
+
+  MotorSim _sim;
+  uint8_t _controlMode = 2;  // VELOCITY_CONTROL
+  uint8_t _inputMode = 2;    // VEL_RAMP
+  float _velRampRate = ODRIVE_VEL_RAMP_RATE;
+  bool _specApplied = false;
+};
+
+VirtualMotorBus g_bus;
+
+}  // namespace
+
+IMotorBus& motorBus() { return g_bus; }
diff --git a/src/motor_sim.cpp b/src/motor_sim.cpp
new file mode 100644
index 0000000..e404fc5
--- /dev/null
+++ b/src/motor_sim.cpp
@@ -0,0 +1,138 @@
+#include "motor_sim.h"
+
+#include <math.h>
+
+MotorSim::MotorSim(const MotorSimSpec& spec) : _spec(spec) {
+  reset();
+}
+
+void MotorSim::reset() {
+  _rpm = 0.0f;
+  _targetRpm = 0.0f;
+  _turns = 0.0f;
+  _vbus = _spec.nominalVbus;
+  _ibus = _spec.idleIbus;
+  _power = _vbus * _ibus;
+  _torque = 0.0f;
+  _fetTemp = _spec.ambientTempC;
+  _iq = 0.0f;
+  _state = 1;  // IDLE
+  _armed = false;
+  _axisError = 0;
+  _lastMs = 0;
+  _armAtMs = 0;
+  _faultFired = 0;
+}
+
+void MotorSim::requestVelocityRpm(float rpm) {
+  if (!_armed || _state != 8) {
+    _targetRpm = 0.0f;
+    return;
+  }
+  if (rpm < 0.0f) rpm = 0.0f;
+  if (rpm > _spec.rpmMax) rpm = _spec.rpmMax;
+  _targetRpm = rpm;
+}
+
+void MotorSim::requestPositionTurns(float turns) {
+  _turns = turns;
+}
+
+void MotorSim::requestTorque(float torqueNm) {
+  // Torque mode is unused by the node; keep the value for completeness.
+  _torque = torqueNm;
+}
+
+void MotorSim::requestState(uint8_t state) {
+  _state = state;
+  _armed = (state == 8);
+  if (_armed) {
+    // Arm after a short delay (mirrors the ODrive's closed-loop entry latency).
+    _armAtMs = _lastMs + _spec.armDelayMs;
+  } else {
+    _targetRpm = 0.0f;
+  }
+}
+
+void MotorSim::clearErrors() {
+  _axisError = 0;
+  _faultFired = 0;
+}
+
+void MotorSim::injectFault(uint32_t mask) {
+  _axisError |= mask;
+  // A real ODrive leaves closed loop on a fault.
+  _state = 1;
+  _armed = false;
+  _targetRpm = 0.0f;
+}
+
+void MotorSim::addFaultEvent(const MotorFaultEvent& ev) {
+  if (_faultCount < kMaxFaults) {
+    _faults[_faultCount++] = ev;
+  }
+}
+
+void MotorSim::tick(uint32_t nowMs) {
+  if (_lastMs == 0) {
+    _lastMs = nowMs;
+    return;
+  }
+  float dt = (float)(nowMs - _lastMs) / 1000.0f;
+  _lastMs = nowMs;
+  if (dt <= 0.0f) return;
+  if (dt > 0.5f) dt = 0.5f;  // clamp long pauses (e.g. WiFi reconnect)
+
+  // --- Data-driven faults --------------------------------------------------
+  for (uint8_t i = 0; i < _faultCount; ++i) {
+    const bool fired = (_faultFired & (1u << i)) != 0;
+    if (!fired && nowMs >= _faults[i].atMs) {
+      _faultFired |= (1u << i);
+      injectFault(_faults[i].mask);
+    }
+  }
+
+  const bool closedLoop = _armed && _state == 8;
+  const bool armSettled = closedLoop && nowMs >= _armAtMs;
+
+  const float prevRpm = _rpm;
+
+  // --- Velocity dynamics ---------------------------------------------------
+  if (armSettled) {
+    const float alpha = dt / (_spec.spinUpTauS + dt);
+    _rpm += (_targetRpm - _rpm) * alpha;
+  } else {
+    // Coast down toward zero when idle / disarmed.
+    const float alpha = dt / (_spec.spinUpTauS + dt);
+    _rpm += (0.0f - _rpm) * alpha;
+    if (_rpm < 0.5f) _rpm = 0.0f;
+  }
+  if (_rpm > _spec.rpmMax) _rpm = _spec.rpmMax;
+
+  // Position integrates velocity.
+  _turns += (_rpm / 60.0f) * dt;
+
+  // --- Load, bus, thermal --------------------------------------------------
+  const float norm = (_spec.rpmMax > 0.0f) ? (_rpm / _spec.rpmMax) : 0.0f;
+  const float loadCurrent = _spec.maxLoadIbus * norm * norm;
+  _ibus = _spec.idleIbus + loadCurrent;
+
+  _vbus = _spec.nominalVbus - _ibus * _spec.busResistance;
+  _power = _vbus * _ibus;
+
+  // Mechanical torque from shaft power and angular speed. Below the load floor the
+  // shaft is essentially unloaded, so report zero rather than amplifying the small
+  // idle power over a near-zero omega (which produced implausible iq spikes at stop).
+  const float omega = (_rpm * 2.0f * 3.14159265f) / 60.0f;
+  _torque = (omega > 1.0f) ? (_power / omega) : 0.0f;
+
+  // q-axis current proxy: torque / (kT) with kT ~ 0.09 Nm/A for this class of motor.
+  // Keep the same threshold as torque so the two stay physically consistent.
+  _iq = (omega > 1.0f) ? (_torque / 0.09f) : 0.0f;
+
+  const float fetTarget = _spec.ambientTempC + _ibus * _spec.tempPerAmp;
+  const float ta = dt / (_spec.tempTauS + dt);
+  _fetTemp += (fetTarget - _fetTemp) * ta;
+
+  (void)prevRpm;
+}
diff --git a/src/motor_sim.h b/src/motor_sim.h
new file mode 100644
index 0000000..2283004
--- /dev/null
+++ b/src/motor_sim.h
@@ -0,0 +1,95 @@
+#pragma once
+/**
+ * @file motor_sim.h
+ * @brief Declarative model of the ODrowe S1 + aeration paddle. Host-testable (no Arduino).
+ *
+ * Everything the virtual motor does is derived from `MotorSimSpec` plus a single tick
+ * engine. This keeps "what the hardware does" in one reviewable place and lets tests run
+ * the exact same code path as the firmware.
+ *
+ * Physics (deliberately simple, protocol/contract fidelity):
+ *   - first-order spin-up toward the commanded RPM (time constant from the spec)
+ *   - quadratic hydrodynamic load  ibus = idle + maxLoad * (rpm / rpmMax)^2
+ *   - DC bus sag                   vbus = nominal - ibus * busResistance
+ *   - FET temperature              fet  = ambient + ibus * tempPerAmp (first-order toward it)
+ *   - torque estimate              tau  = power / omega
+ *   - ODrive state machine         IDLE(1) <-> CLOSED_LOOP_CONTROL(8), faults disarm
+ */
+
+#include <stdint.h>
+
+/** Declarative description of the motor + driver. */
+struct MotorSimSpec {
+  float rpmMax = 600.0f;          // Velocity envelope (matches MAX_MOTOR_RPM)
+  float spinUpTauS = 0.35f;       // First-order velocity time constant (s)
+  float nominalVbus = 24.0f;      // Nominal DC bus (V)
+  float busResistance = 0.035f;   // Effective source resistance (V/A)
+  float idleIbus = 0.15f;         // Quiescent electronics current (A)
+  float maxLoadIbus = 9.5f;       // Current at rpmMax under water load (A)
+  float ambientTempC = 28.0f;     // FET ambient (degC)
+  float tempPerAmp = 1.5f;        // FET rise per amp (degC/A)
+  float tempTauS = 4.0f;          // FET thermal time constant (s)
+  uint32_t armDelayMs = 150;      // Delay after a closed-loop request before it takes effect
+};
+
+/** Fault schedule entry: apply `mask` to axis_error once `atMs` is reached. */
+struct MotorFaultEvent {
+  uint32_t atMs;
+  uint32_t mask;   // active_errors bitmask
+};
+
+class MotorSim {
+public:
+  explicit MotorSim(const MotorSimSpec& spec = MotorSimSpec());
+
+  void reset();
+  void setSpec(const MotorSimSpec& spec) { _spec = spec; }
+
+  void requestVelocityRpm(float rpm);   // ignored unless armed
+  void requestPositionTurns(float turns);
+  void requestTorque(float torqueNm);
+  void requestState(uint8_t state);
+  void clearErrors();
+  void injectFault(uint32_t mask);
+
+  /** Advance the model. Deterministic: no internal clock reads. */
+  void tick(uint32_t nowMs);
+
+  bool isArmed() const { return _armed; }
+  uint8_t state() const { return _state; }
+  float actualRpm() const { return _rpm; }
+  float targetRpm() const { return _targetRpm; }
+  float vbus() const { return _vbus; }
+  float ibus() const { return _ibus; }
+  float power() const { return _power; }
+  float torque() const { return _torque; }
+  float fetTemp() const { return _fetTemp; }
+  float iq() const { return _iq; }
+  uint32_t axisError() const { return _axisError; }
+
+  // Fault scheduling (data-driven).
+  void addFaultEvent(const MotorFaultEvent& ev);
+  void clearFaultSchedule() { _faultCount = 0; }
+
+private:
+  MotorSimSpec _spec;
+  float _rpm = 0.0f;
+  float _targetRpm = 0.0f;
+  float _turns = 0.0f;
+  float _vbus = 24.0f;
+  float _ibus = 0.15f;
+  float _power = 0.0f;
+  float _torque = 0.0f;
+  float _fetTemp = 28.0f;
+  float _iq = 0.0f;
+  uint8_t _state = 1;   // IDLE
+  bool _armed = false;
+  uint32_t _axisError = 0;
+  uint32_t _lastMs = 0;
+  uint32_t _armAtMs = 0;
+  uint32_t _faultFired = 0;
+
+  static constexpr uint8_t kMaxFaults = 8;
+  MotorFaultEvent _faults[kMaxFaults] = {};
+  uint8_t _faultCount = 0;
+};
