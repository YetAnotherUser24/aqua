# PlatformIO & Embedded Build Artifacts
.pio/
.pioenvs/
.piolibdeps/
*.bin
*.elf
*.hex
aqua-station/firmware/virtual_node/virtual_node

# Python Environments & Caches
.venv/
.venv-gateway/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.bench/

# Node.js & Web Build Artifacts
node_modules/
dist/
build/
.next/
out/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.history/
.DS_Store
Thumbs.db

# Logs & Temporary Files
*.log
*.tmp
*.bak
deploy/*.log

# Environment & Secret files
.env
*.env
*.env.local


# Telemetry Archives (Runtime CSV storage on bench/gateway)
/data/
aqua-station/data/
*.csv.gz
